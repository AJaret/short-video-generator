{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": ["webpack-env"],
    "baseUrl": ".",
    "paths": {
      "@canal": ["src/canal/index.ts"],
      "@canal/*": ["src/canal/*"],
      "*": ["node_modules/@types/*", "node_modules/*"]
    }
  },
  "include": ["src", "remotion.config.ts", "../episodios/**/*.tsx"]
}
